rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }

    match /services/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{document} {
      allow read: if resource == null || resource.data.is_active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /testimonials/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blog_posts/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /landing_images/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /landing_feed/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_reviews/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blog_comments/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. User Profiles
    match /profiles/{userId} {
      allow read, write: if true;
    }

    // 3. Transactions & Submissions
    match /bookings/{document} {
      allow read: if true;
      allow create, update: if true;
    }
    match /orders/{document} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true);
      allow create: if true;
    }
    match /messages/{document} {
      allow create: if true;
      allow read, update: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }
    match /newsletter/{document} {
      allow create: if true;
      allow read: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }
    match /availability/{document} {
      allow read, write: if true;
    }
    match /session_slots/{document} {
      allow read, write: if true;
    }
    match /holidays/{document} {
      allow read, write: if true;
    }
    match /coupons/{document} {
      allow read, write: if true;
    }
    match /healers/{document} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }
    match /recommendation_rules/{document} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }
    match /cms/{document} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }
    match /workshops/{document} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }
    match /workshopRegistrations/{document} {
      allow read: if true;
      allow create, update: if true;
    }
    match /workshopFeedback/{document} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }
    match /recentVisits/{document} {
      allow read, write: if true;
    }
    match /notifications/{document} {
      allow read, write: if true;
    }
    match /payments/{document} {
      allow read, write: if true;
    }
    match /error_logs/{document} {
      allow read, write: if true;
    }
    match /whatsappLogs/{document} {
      allow read, write: if true;
    }
    match /notification_logs/{document} {
      // Workers write logs server-side; admins can read
      allow read: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
      allow write: if true; // written by server-side workers only
    }
    match /failed_notifications/{document} {
      // DLQ entries written server-side; admins can read and delete
      allow read, delete: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
      allow create: if true; // written by server-side DLQ writer
    }
    match /audit_logs/{document} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
      allow create: if true;
    }
    match /session_locks/{document} {
      allow read, write: if true;
    }
    match /somatic_packages/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /session_notes/{document} {
      allow read: if true;
      allow write: if true;
    }
  }
}
